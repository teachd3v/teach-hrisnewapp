{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "teach-hris-spa",
	"pages_build_output_dir": "web/dist",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "hris-spa-db",
			"database_id": "50cdf64e-466e-49e9-abdc-51949f9d5b9b",
			"migrations_dir": "api/migrations"
		}
	],
	"r2_buckets": [{ "binding": "STORAGE", "bucket_name": "hris-spa-storage" }],
	"vars": {
		"WEB_ORIGIN": "https://app.hrteach.site",
		// Kunci publik VAPID (bukan rahasia). Kunci privatnya: secret VAPID_PRIVATE_KEY.
		"VAPID_PUBLIC_KEY": "BF5dj2JfcGZsdvnkI5bX17VX0qsQmNmWpzZrEeRIWoNe4kTQT7tC0fP_LiY0OsobAlWKqFpfdXLRFk_8HEP_PfU",
		"VAPID_SUBJECT": "https://app.hrteach.site"
	}
}
