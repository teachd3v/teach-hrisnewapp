{
  "name": "teach-hris-spa",
  "private": true,
  "type": "module",
  "workspaces": ["shared", "api", "web"],
  "scripts": {
    "dev:web": "npm run dev -w web",
    "dev:api": "wrangler pages dev web/dist --compatibility-date=2026-08-01 --compatibility-flag=nodejs_compat",
    "build": "npm run build -w web",
    "typecheck": "npm run typecheck -ws --if-present",
    "db:generate": "npm run db:generate -w api",
    "deploy": "npm run build && wrangler pages deploy web/dist"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "wrangler": "^4.156.0"
  }
}
